<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MarantzController</RootNamespace>
    <AssemblyName>MarantzController</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon is drawn by tools/Generate-Icon.ps1 (vector, 16..256 px). -->
    <ApplicationIcon>MarantzController.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Local, non-public material is never part of the build. -->
  <ItemGroup>
    <Compile Remove="_private\**" />
    <Page Remove="_private\**" />
    <None Remove="_private\**" />
  </ItemGroup>

</Project>
